    {
      "id": "2",
      "data": {
        "name": "Summarize Eligibility",
        "type": "LLM Text",
        "inputs": {
          "prompt": "Summarize the eligibility, funding amount, and deadline from this grant info:\n\n{{input}}"
        }
      },
      "position": [300, 100]
    },
    {
      "id": "3",
      "data": {
        "name": "Match to M.O.B. Initiative",
        "type": "LLM Text",
        "inputs": {
          "prompt": "Match the summarized grant info to one of the following M.O.B. initiatives: STEM Expo, Mobile Hubs, Membership Scholarships, Community Gala, or Atlanta Trip. Explain why.\n\nGrant Info:\n{{input}}"
        }
      },
      "position": [500, 100]
    },
    {
      "id": "4",
      "data": {
        "name": "Draft Proposal Outline",
        "type": "LLM Text",
