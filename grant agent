  "name": "Grant & Funding Organizer",
  "flow": [
    {
      "id": "1",
      "data": {
        "name": "Search Grants",
        "type": "WebSearch",
        "inputs": {
          "query": "Upcoming grants for entrepreneurship, economic empowerment, or community building",
          "numResults": 5
        }
      },
      "position": [100, 100]
